<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>pixel API</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: system-ui, sans-serif; background: #0f0f0f; color: #e2e2e2; padding: 2.5rem 1.5rem; line-height: 1.6; max-width: 720px; margin: 0 auto; }
        header { margin-bottom: 3rem; }
        h1 { font-size: 2rem; font-weight: 700; }
        h1 span { color: #a78bfa; }
        .tagline { color: #666; font-size: 0.95rem; margin-top: 0.25rem; }
        section { margin-bottom: 2.5rem; }
        h2 { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #555; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid #1e1e1e; }
        .endpoint { display: flex; gap: 1rem; align-items: flex-start; padding: 0.9rem 1rem; background: #161616; border: 1px solid #222; border-radius: 8px; margin-bottom: 0.5rem; }
        .endpoint:last-child { margin-bottom: 0; }
        .method { font-size: 0.7rem; font-weight: 700; background: #1e1b4b; color: #a78bfa; padding: 0.25rem 0.6rem; border-radius: 4px; flex-shrink: 0; margin-top: 0.15rem; letter-spacing: 0.05em; }
        .info { flex: 1; min-width: 0; }
        .path { font-family: ui-monospace, monospace; font-size: 0.9rem; color: #f0f0f0; word-break: break-all; }
        .path em { color: #a78bfa; font-style: normal; }
        .desc { font-size: 0.85rem; color: #777; margin-top: 0.2rem; }
        .params { margin-top: 0.55rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
        .param { font-family: ui-monospace, monospace; font-size: 0.72rem; background: #1e1e1e; border: 1px solid #2a2a2a; border-radius: 4px; padding: 0.15rem 0.5rem; color: #999; }
        .param b { color: #c4b5fd; font-weight: 500; }
        a { color: inherit; text-decoration: none; }
        a:hover .path { text-decoration: underline; text-decoration-color: #444; }
    </style>
</head>
<body>
    <header>
        <h1>pixel <span>API</span></h1>
        <p class="tagline">Random image server</p>
    </header>

    {% for group in groups %}
    <section>
        <h2>{{ group.label }}</h2>
        {% for endpoint in group.endpoints %}
        <div class="endpoint">
            <span class="method">{{ endpoint.method }}</span>
            <div class="info">
                <div class="path">
                    {% if endpoint.url is defined %}
                        <a href="{{ endpoint.url }}">{{ endpoint.path | raw }}</a>
                    {% else %}
                        {{ endpoint.path | raw }}
                    {% endif %}
                </div>
                <div class="desc">{{ endpoint.desc }}</div>
                {% if endpoint.params is defined %}
                <div class="params">
                    {% for param in endpoint.params %}
                    <span class="param"><b>{{ param.name }}</b> {{ param.hint }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </section>
    {% endfor %}
</body>
</html>
